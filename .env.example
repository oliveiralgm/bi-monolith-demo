# Copy to .env for local runs. Do not commit .env.
#
# Local default: set a key and leave BI_DEMO_PUBLIC unset/0 (locked until unlock).
# Hosted playground: set BI_DEMO_PUBLIC=1 so visitors can open the sample without a key.
BI_DEMO_KEY=replace-with-a-long-random-string
BI_DEMO_PUBLIC=0
FLASK_SECRET_KEY=replace-with-another-random-string
HOST=127.0.0.1
PORT=8050
